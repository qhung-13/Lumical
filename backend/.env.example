# pnpm dev loads an optional local .env through Node's native env-file support.
PORT=3001
NODE_ENV=development
IDENTITY_COOKIE_MODE=loopback
# Empty for direct/local development. Never trust all proxies or whole subnets.
IDENTITY_TRUSTED_PROXY_IPS=
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000
# Generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IDENTITY_SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX_KEY
# Technical per-process abuse policy: email limit, 5x IP aggregate, fixed window, bounded buckets.
IDENTITY_AUTH_ATTEMPTS=10
IDENTITY_AUTH_WINDOW_SECONDS=600
IDENTITY_AUTH_BUCKETS=10000
# Match root .env passwords. The running backend never needs migration credentials.
DATABASE_URL=postgresql://lumical_runtime:REPLACE_WITH_RANDOM_HEX_RUNTIME_PASSWORD@127.0.0.1:5432/lumical_dev?schema=lumical
MIGRATION_DATABASE_URL=postgresql://lumical_migration:REPLACE_WITH_RANDOM_HEX_MIGRATION_PASSWORD@127.0.0.1:5432/lumical_dev?schema=lumical
