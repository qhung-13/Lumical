{
  "name": "lumical",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && pnpm --dir backend test:e2e",
    "test:db": "pnpm --dir backend test:db",
    "test:docker": "pnpm --dir backend test:docker",
    "contract:generate": "pnpm --dir backend build && node backend/scripts/export-openapi.mjs && pnpm --dir frontend exec openapi-typescript ../backend/openapi.json -o src/api/generated.ts",
    "contract:check": "node backend/scripts/export-openapi.mjs --check && node frontend/scripts/check-contract.mjs",
    "test:identity": "pnpm --dir backend test:identity",
    "test:proxy": "node --test infra/proxy.test.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm contract:check && pnpm test:proxy && pnpm test:db",
    "format": "pnpm -r --if-present format"
  }
}
