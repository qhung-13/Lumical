# Server-only backend origin; never prefix this variable with NEXT_PUBLIC_.
# Docker Compose supplies http://backend:3001 instead.
BACKEND_URL=http://localhost:3001
# Development SSR cookie name only; production always uses __Host-lumical_session.
ACCOUNT_COOKIE_NAME=lumical_session_dev
# Academic Vercel demo only: same random key as Render, server-side only.
# BACKEND_URL must use HTTPS when this key is configured or VERCEL=1.
# LUMICAL_GATEWAY_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX_GATEWAY_KEY
