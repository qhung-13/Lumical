# Generate three DIFFERENT local hexadecimal passwords; never commit .env.
# Placeholders deliberately fail PostgreSQL initialization.
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_HEX_BOOTSTRAP_PASSWORD
MIGRATION_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_MIGRATION_PASSWORD
RUNTIME_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_RUNTIME_PASSWORD
POSTGRES_DB=lumical_dev
POSTGRES_PORT=5432
FRONTEND_PORT=3000
BACKEND_PORT=3001
# Compose uses deployed Secure cookies. HTTPS termination must preserve client socket addresses (see README).
IDENTITY_SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX_KEY
IDENTITY_ALLOWED_ORIGINS=https://lumical.example.test
# The backend trusts only this immediate gateway address on the private Compose network.
# Keep the gateway outside the dynamic pool; change all three together for another subnet.
LUMICAL_NETWORK_SUBNET=172.30.240.0/24
LUMICAL_DYNAMIC_IP_RANGE=172.30.240.128/25
LUMICAL_GATEWAY_IP=172.30.240.2
